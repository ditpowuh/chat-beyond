{
  "name": "chat-beyond",
  "version": "1.0.0",
  "description": "A web interface to use OpenAI's API, made to be familiar and easy.",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently 'bun run server:dev' 'bun run client:dev'",
    "server:dev": "bun src/index.ts --tsconfig-override tsconfig.bun.json",
    "server:check": "bun x tsc -p tsconfig.bun.json",
    "build:windows": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile output/ChatBeyond-windows-x64",
    "build:mac": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile output/ChatBeyond-macos-arm64",
    "client:build": "vite build",
    "client:dev": "vite",
    "node:start": "node dist/index.js",
    "node:compile": "tsc -p tsconfig.node.json && tsc-alias -p tsconfig.node.json",
    "postinstall": "patch-package"
  },
  "author": "Ditpowuh",
  "license": "MIT",
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/probe-image-size": "^7.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "patch-package": "^8.0.1",
    "tsc-alias": "^1.9.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5"
  },
  "dependencies": {
    "@tsparticles/confetti": "^4.4.0",
    "chalk": "^6.0.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "lenis": "^1.3.26",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "marked-katex-extension": "^5.1.13",
    "motion": "^14.2.0",
    "open": "^11.0.4",
    "openai": "^7.33.0",
    "probe-image-size": "^7.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-textarea-autosize": "^8.5.9",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sweetalert2": "^11.26.25",
    "tiktoken": "^1.0.22",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.3"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.4"
  },
  "allowScripts": {
    "@tsparticles/engine": true
  }
}
