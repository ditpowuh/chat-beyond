{
  "name": "chat-beyond",
  "version": "1.0.0",
  "description": "A web interface to use OpenAI's API, made to be familiar and easy.",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently 'bun run server:dev' 'bun run client:dev'",
    "server:dev": "bun src/index.ts --tsconfig-override tsconfig.bun.json",
    "server:check": "bun x tsc -p tsconfig.bun.json",
    "build:windows": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile output/ChatBeyond-windows-x64",
    "build:mac": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile output/ChatBeyond-macos-arm64",
    "client:build": "vite build",
    "client:dev": "vite",
    "node:start": "node dist/index.js",
    "node:compile": "tsc -p tsconfig.node.json",
    "postinstall": "patch-package"
  },
  "author": "Ditpowuh",
  "license": "MIT",
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vite-plugin-checker": "^0.12.0"
  },
  "dependencies": {
    "@tsparticles/confetti": "^3.9.1",
    "chalk": "^5.6.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "image-size": "^2.0.2",
    "lenis": "^1.3.23",
    "mammoth": "^1.12.0",
    "marked": "^17.0.6",
    "marked-katex-extension": "^5.1.8",
    "open": "^11.0.0",
    "openai": "6.33.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-textarea-autosize": "^8.5.9",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sweetalert2": "^11.26.24",
    "tiktoken": "^1.0.22",
    "unpdf": "^1.6.2",
    "uuid": "^14.0.0"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.4"
  }
}
